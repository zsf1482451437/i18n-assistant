{
  "name": "i18n-server",
  "version": "1.0.0",
  "description": "i18nexus翻译管理器",
  "main": "server.js",
  "scripts": {
    "start": "node start.js",
    "dev": "cross-env NODE_ENV=development node start.js",
    "test": "cross-env NODE_ENV=testing node start.js",
    "prod": "cross-env NODE_ENV=production node start.js",
